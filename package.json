{
  "name": "@flun/nodejs-mobile-gyp",
  "description": "Node.js for Mobile Apps native addon build tool (flun fork)",
  "keywords": [
    "nodejs-mobile",
    "native",
    "addon",
    "module",
    "c",
    "c++",
    "bindings",
    "gyp"
  ],
  "version": "1.2.2",
  "installVersion": 11,
  "author": "flun <open@flun.top>",
  "bin": {
    "nodejs-mobile-gyp": "./bin/node-gyp.js"
  },
  "main": "./lib/node-gyp.js",
  "files": [
    "bin/",
    "gyp/data/",
    "gyp/pylib/gyp/",
    "gyp/pylib/packaging/",
    "!gyp/pylib/gyp/__pycache__/",
    "!gyp/pylib/gyp/generator/__pycache__/",
    "!gyp/pylib/gyp/**/*_test.py",
    "!gyp/pylib/packaging/__pycache__/",
    "gyp/gyp",
    "gyp/gyp_main.py",
    "gyp/gyp.bat",
    "lib/",
    "src/",
    "addon.gypi",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "chalk": "^6.0.1",
    "env-paths": "^4.0.0",
    "exponential-backoff": "^3.1.3",
    "glob": "^14.0.3",
    "graceful-fs": "^4.2.11",
    "make-fetch-happen": "^16.0.1",
    "nopt": "^10.0.1",
    "proc-log": "^7.0.0",
    "semver": "^7.8.6",
    "tar": "^7.5.22",
    "which": "^7.0.0"
  },
  "allowScripts": {
    "node": true
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "homepage": "https://github.com/OpenFlun/nodejs-mobile-gyp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenFlun/nodejs-mobile-gyp.git"
  },
  "gitee": {
    "type": "git",
    "url": "https://gitee.com/OpenFlun/nodejs-mobile-gyp.git"
  },
  "bugs": {
    "url": "https://github.com/OpenFlun/nodejs-mobile-gyp/issues"
  },
  "license": "ISC",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
