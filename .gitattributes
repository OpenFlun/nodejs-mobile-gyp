# 默认：文本文件，仓库内统一 LF
* text=auto eol=lf

# 源码
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.py    text eol=lf
*.gyp   text eol=lf
*.gypi  text eol=lf
*.toml  text eol=lf

# Unix shell 脚本：必须 LF，否则 Linux/macOS 执行报错
*.sh    text eol=lf

# Windows 专属脚本：CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制文件（不做换行符转换）
*.so    binary
*.a     binary
*.o     binary
*.node  binary
*.dll   binary
*.dylib binary
*.exe   binary
*.jar   binary
*.zip   binary
*.tgz   binary
*.gz    binary
*.tar   binary